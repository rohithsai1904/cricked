# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cricked

# JWT secret (generate a random string)
JWT_SECRET=your-secret-key

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public URL of this API (no trailing slash)
API_URL=https://your-app.onrender.com

# Public URL of the frontend (no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# CricAPI key
CRICAPI_KEY=your-cricapi-key

# Sentry DSN (optional)
SENTRY_DSN=
NODE_ENV_DSN=production

# Admin email for admin middleware
ADMIN_EMAIL=your-admin@gmail.com
